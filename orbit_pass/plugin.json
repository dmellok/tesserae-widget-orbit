      "default": "none",
      "choices": [
        {
          "value": "none",
          "label": "None: the spacecraft alone, cut out on the page"
        },
        {
          "value": "space",
          "label": "Black space and stars"
        },
        {
          "value": "limb",
          "label": "Above the Earth's limb"
        },
        {
          "value": "earth",
          "label": "Over the Earth by day"
        },
        {
          "value": "night",
          "label": "Over the Earth by night"
        },
        {
          "value": "sunrise",
          "label": "Orbital sunrise"
        },
        {
          "value": "ornate",
          "label": "Ornate framed plate"
        }
      ],
      "show_if": {
        "pictures": "paintings"
      },
      "help": "None keeps the spacecraft alone on the page, cut out. The rest paint a whole picture that fills its frame, in the same style."
    },
    {
      "name": "paper",
      "type": "select",
      "label": "Paper",
      "default": "cream",
      "choices": [
        {
          "value": "cream",
