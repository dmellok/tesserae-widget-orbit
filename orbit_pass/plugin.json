{
  "tesserae_compat": "1.x",
  "name": "Orbit: Pass",
  "version": "0.2.2",
  "kind": "widget",
  "tesserae_min": "0.463.0",
  "description": "The best pass over your place to-night: the station or the brightest satellite coming, painted in a ruled frame, with a sky chart of its path, the rise and set times and directions, how high and how bright. Passes worked out on your server from CelesTrak's element sets, no key.",
  "icon": "ph-planet",
  "supports": {
    "sizes": [
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "network:*",
    "settings:plugin/orbit_core",
    "plugin:orbit_core"
  ],
  "render": {
    "needs_network": true,
    "warm_ahead_s": 150
  },
  "design": {
    "palette": "extended"
  },
  "cell_options": [
    {
      "name": "location",
      "type": "location_search",
      "label": "Place",
      "default": "",
      "help": "Where you will be looking up from; the times are the place's own. Falls back to the app's location."
    },
    {
      "name": "pictures",
      "type": "select",
      "label": "Pictures",
      "default": "paintings",
      "choices": [
        {
          "value": "paintings",
          "label": "AI paintings, each object once"
        },
        {
          "value": "silhouettes",
          "label": "Silhouettes"
        }
      ],
      "help": "AI paintings paint each object once in the style below, from a NASA photograph for the station and Hubble and from its description otherwise, at about US$0.04 a painting; needs a fal.ai key. Silhouettes cost nothing."
    },
    {
      "name": "style",
      "type": "select",
      "label": "Style",
      "default": "poster",
      "choices": [
        {
          "value": "poster",
          "label": "Space-age poster"
        },
        {
          "value": "engraving_colour",
          "label": "Hand-coloured engraving"
        },
        {
          "value": "engraving",
