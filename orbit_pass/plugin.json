        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "aged",
          "label": "Aged"
        },
        {
          "value": "blueprint",
          "label": "Blueprint: pale ink on blue"
        },
        {
          "value": "night",
          "label": "Night: pale ink on near-black"
        }
      ]
    },
    {
      "name": "which",
      "type": "select",
      "label": "Which objects",
      "default": "bright",
      "choices": [
        {
          "value": "bright",
          "label": "The stations and the brightest satellites (CelesTrak's visual list)"
        },
        {
          "value": "stations",
          "label": "The space stations only"
        }
      ],
      "help": "The visual list is the hundred-odd objects bright enough to see with the eye: the stations, Hubble, big satellites and spent rocket stages.",
      "advanced": true
    },
    {
      "name": "min_el",
      "type": "select",
      "label": "At least this high",
      "default": "20",
      "choices": [
        {
          "value": "10",
          "label": "10° (low over the horizon)"
        },
        {
          "value": "20",
          "label": "20°"
        },
        {
          "value": "30",
          "label": "30°"
        },
        {
          "value": "45",
          "label": "45° (high overhead)"
        }
      ],
      "help": "A pass counts when the object climbs at least this high while lit and the sky is dark.",
      "advanced": true
    },
    {
      "name": "hours",
      "type": "select",
